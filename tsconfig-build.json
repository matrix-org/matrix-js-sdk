{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "forceConsistentCasingInFileNames": true,
        "declarationMap": true,
        "sourceMap": true,
        "noEmit": false,
        "outDir": "./lib",
        "rootDir": "src",
        // Override and remove `vitest/globals`, since the library build should
        // not depend on test-only types.
        "types": ["node"]
    },
    "exclude": ["./spec/**/*.ts"]
}
